# Everything here can also be set from Settings inside the app.
# Values set here take precedence over values saved in the app.

# GoHighLevel — Settings → Private Integrations → Create new integration.
# Scopes: contacts, opportunities, calendars, conversations, conversations/message, locations (read).
# For Instagram / Messenger / WhatsApp DMs, also connect those accounts inside GoHighLevel (Settings → Integrations).
# Optional: users.readonly, locations/customFields.readonly, locations/tasks.readonly (owners, custom fields, all-tasks list).
GHL_API_KEY=
GHL_LOCATION_ID=

# Claude (Anthropic) — powers the agent playbooks: call prep, scripts, follow-ups, proposals.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Meta (Facebook / Instagram) Ads — Business Settings → System users → Generate token.
# Permissions: ads_read, ads_management, leads_retrieval, pages_show_list, pages_read_engagement, pages_manage_metadata, business_management.
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
# META_GRAPH_VERSION=v23.0

# Google Places API (New) — powers "Find clients". Enable "Places API (New)" in Google Cloud.
GOOGLE_PLACES_API_KEY=

PORT=4400
