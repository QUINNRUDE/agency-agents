{
  "name": "clientline",
  "version": "1.0.0",
  "private": true,
  "description": "Client command center: find, track and manage clients, run calls, and put every Agency agent to work. Connects to GoHighLevel.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx test/ghl.test.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.14.0",
    "express": "^5.3.0",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/instrument-sans": "^5.3.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.11",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "lucide-react": "^1.81.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "typescript": "^7.0.2",
    "vite": "^8.4.0"
  }
}
